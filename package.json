{
  "name": "solid-groove",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.2.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@sentry/browser": "10.68.0",
    "@sentry/vite-plugin": "5.3.0",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.18",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@solidjs/vite-plugin": "3.0.0-next.34",
    "@solidjs/web": "2.0.0-rc.3",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/nodemailer": "^8.0.2",
    "@vitest/ui": "4.1.11",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.3",
    "firebase": "^12.3.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^25.0.1",
    "nanoid": "^6.0.0",
    "node-web-audio-api": "^2.1.0",
    "nodemailer": "^10.0.15",
    "ogg-opus-decoder": "^1.7.5",
    "since-time-ago": "^1.1.1",
    "solid-icons": "1.2.0",
    "solid-js": "2.0.0-rc.3",
    "tone": "^15.1.22",
    "typescript": "^5.6.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "zod": "^4.4.3"
  },
  "scripts": {
    "samples": "node --env-file-if-exists=.env scripts/generate-samples.mjs && node --env-file-if-exists=.env scripts/starter-library/emitRuntime.mjs",
    "library": "node --env-file-if-exists=.env scripts/starter-library/help.mjs",
    "library:acquire": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs",
    "library:manage": "node --env-file-if-exists=.env scripts/starter-library/manage.mjs",
    "library:vcsl": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs --vcsl",
    "library:producer-space": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs --producer-space",
    "library:freepats-bank": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs --freepats-bank",
    "library:freesound": "node --env-file-if-exists=.env scripts/starter-library/freesound.mjs",
    "library:candidates": "node --env-file-if-exists=.env scripts/starter-library/acquire/generateCandidates.mjs",
    "library:build": "node --env-file-if-exists=.env scripts/starter-library/build.mjs",
    "library:emit-runtime": "node --env-file-if-exists=.env scripts/starter-library/emitRuntime.mjs",
    "library:emit-fixtures": "node --env-file-if-exists=.env scripts/starter-library/emitBrowserFixtures.mjs",
    "library:audition": "node --env-file-if-exists=.env scripts/starter-library/audition.mjs",
    "library:validate": "node --env-file-if-exists=.env scripts/starter-library/build.mjs --dry-run",
    "library:audit": "node --env-file-if-exists=.env scripts/starter-library/audit.mjs",
    "library:upload": "node --env-file-if-exists=.env scripts/starter-library/upload.mjs",
    "library:test": "vitest run --project=library-pipeline",
    "predev": "bun run samples && node --env-file-if-exists=.env scripts/starter-library/checkLocal.mjs",
    "dev": "vite",
    "predev:mock": "bun run samples && node --env-file-if-exists=.env scripts/starter-library/checkLocal.mjs",
    "dev:mock": "VITE_DEV_BACKEND=mock vite",
    "predev:emulator": "bun run samples && node --env-file-if-exists=.env scripts/starter-library/checkLocal.mjs",
    "dev:emulator": "VITE_DEV_BACKEND=emulator vite",
    "prebuild": "bun run samples",
    "build": "vite build",
    "start": "vite preview",
    "clean": "rm -rf .output dist node_modules/.vite test-results playwright-report playwright-results.json blob-report vitest-report",
    "functions:build": "bun build functions/src/index.ts --outdir functions/lib --target node --format esm --packages external",
    "prefirebase:emulator": "bun run functions:build",
    "firebase:emulator": "firebase emulators:start --only firestore,auth,storage,functions --project demo-solid-groove",
    "test": "vitest run --project=domain --project=audio --project=ui --project=data --project=platform --project=functions",
    "test:all": "vitest run",
    "test:library": "vitest run --project=library-pipeline",
    "test:watch": "vitest --project=domain --project=audio --project=ui --project=data --project=platform --project=functions",
    "test:ui": "vitest --ui",
    "eval:assistant": "bun scripts/eval-assistant.ts",
    "test:emulator": "firebase emulators:exec --only firestore,storage --project demo-solid-groove \"vitest run --config tests/emulator/vitest.config.ts\"",
    "pretest:browser:emulator:chromium": "bun run samples && bun run functions:build",
    "test:browser:emulator:chromium": "firebase emulators:exec --only firestore,auth,storage,functions --project demo-solid-groove \"playwright test --config=tests/e2e/emulator/playwright.config.ts --project=chromium\"",
    "pretest:browser:emulator": "bun run samples && bun run functions:build",
    "test:browser:emulator": "firebase emulators:exec --only firestore,auth,storage,functions --project demo-solid-groove \"playwright test --config=tests/e2e/emulator/playwright.config.ts\"",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit",
    "prewalkthrough:capture": "bun run samples && bun run functions:build",
    "walkthrough:capture": "CAPTURE_WALKTHROUGH=1 firebase emulators:exec --only firestore,auth,storage,functions --project demo-solid-groove \"playwright test --config=tests/e2e/emulator/playwright.config.ts --project=chromium --workers=1 flows\"",
    "prescreenshots": "bun run samples && bun run functions:build",
    "screenshots": "node scripts/screenshots.mjs",
    "prelanding:capture": "bun run samples && bun run functions:build",
    "landing:capture": "CAPTURE_LANDING=1 firebase emulators:exec --only firestore,auth,storage,functions --project demo-solid-groove \"playwright test --config=tests/e2e/emulator/playwright.config.ts --project=chromium --workers=1 landing.screens\"",
    "walkthrough:publish": "node scripts/walkthrough/publish.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && biome check && bun run verify:no-solid-1",
    "check:fix": "biome check --write",
    "verify:bundle": "node --env-file-if-exists=.env scripts/verify-no-secrets-in-bundle.mjs",
    "verify:budget": "node --env-file-if-exists=.env scripts/verify-bundle-budget.mjs",
    "verify:client-config": "node --env-file-if-exists=.env scripts/verify-client-config.mjs",
    "verify:core-flows": "node scripts/check-core-flows.mjs",
    "verify:test-projects": "node scripts/check-test-projects.mjs",
    "predeploy": "bun run build && bun run verify:bundle && bun run verify:client-config && bun run verify:landing-static",
    "deploy": "firebase deploy --only hosting,firestore,storage,functions --non-interactive --project \"$FIREBASE_PROJECT_ID\"",
    "smoke:hosted": "playwright test --config=tests/e2e/hosted/playwright.config.ts",
    "verify:no-solid-1": "node scripts/check-no-solid-1.mjs",
    "postbuild": "node scripts/emit-app-shell.mjs",
    "verify:landing-static": "node scripts/verify-landing-static.mjs",
    "allowlist:add": "bun scripts/access/allowlistAdd.ts",
    "allowlist:seed": "bun scripts/access/allowlistSeed.ts",
    "admin:grant": "bun scripts/access/adminGrant.ts",
    "qa:accounts": "bun scripts/access/qaAccounts.ts"
  },
  "type": "module",
  "trustedDependencies": [
    "@firebase/util",
    "@parcel/watcher",
    "protobufjs"
  ]
}
