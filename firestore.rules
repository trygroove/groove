rules_version = '2';

// Schema-v1 security rules (PRD 9.9).
//
// Ownership lives on the metadata document only. Child documents under
// `song`, `clips`, and `arrangement` inherit access by resolving their parent,
// so a document can never claim an owner its project does not agree with. Each
// child write costs one document read for that lookup, which is the price of
// not duplicating (and eventually contradicting) ownership on every tier.
//
// The rules also refuse structurally wrong writes: an unknown schema version, a
// missing revision, an unexpected metadata field, or a child document whose
// `projectId` does not match the path it is being written to.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Anonymous Firebase identities are real identities (PRJ-01): they own
    // projects exactly like a registered user, and upgrading the account keeps
    // the same uid, so nothing here distinguishes them.
    // `get(field, default)` keeps the check total: a document that predates or
    // violates the schema is denied, not an evaluation error that fails a whole
    // query.
    function isMember(data) {
      return signedIn() && (
        request.auth.uid == data.get('ownerId', '') ||
        request.auth.uid in data.get('collaboratorIds', [])
      );
    }

    function memberOfProject(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
    }

    // `packDependencies` is the derived pack dependency list (LIB-05): one
    // `{ packId, version }` entry per pack the project's assets resolve from.
    // `addedPacks` is the project's pack shelf (LIB-08): the packs the user has
    // added, a superset of the dependency list. The rules check both are lists;
    // the decoder checks their relationship, which the rules cannot see without
    // reading the song document.
    function metadataFields() {
      return ['schemaVersion', 'revision', 'name', 'ownerId', 'collaboratorIds',
              'createdAt', 'modifiedAt', 'template', 'genre', 'packDependencies',
              'addedPacks'];
    }

    function validMetadata(data) {
      return data.keys().hasOnly(metadataFields())
        && data.keys().hasAll(metadataFields())
        && data.schemaVersion == 6
        && data.revision is int && data.revision >= 0
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.ownerId is string && data.ownerId.size() > 0
        && data.collaboratorIds is list
        && data.packDependencies is list
        && data.addedPacks is list
        && data.createdAt is int && data.createdAt >= 0
        && data.modifiedAt is int && data.modifiedAt >= data.createdAt;
    }

    // Every child document names the project it belongs to, so a document
    // copied out of another project is rejected rather than silently adopted.
    function validChild(projectId, data) {
      return data.projectId == projectId
        && data.schemaVersion == 6
        && data.revision is int && data.revision >= 0
        && data.updatedAt is int && data.updatedAt >= 0;
    }

    // A registered account, not a guest. Personal packs need one (#282).
    function registered() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // One personal pack (#282, LIB-05 `kind: "user"`): its name, its version,
    // and its sounds, whose audio lives in Cloud Storage under the same user.
    // `src/userLibrary/userPacks.ts` owns the full shape; the rules check what
    // keeps one user's library well-formed and theirs. A pack's sounds are
    // inline in this one document, which Firestore caps at 1 MiB, so it holds
    // at most 500 (`MAX_PACK_SOUNDS` in `src/userData/userData.ts`).
    function userPackFields() {
      return ['schemaVersion', 'id', 'kind', 'name', 'version', 'assets',
              'createdAt', 'modifiedAt'];
    }

    function validUserPack(packId, data) {
      return data.keys().hasOnly(userPackFields())
        && data.keys().hasAll(userPackFields())
        && data.schemaVersion == 1
        && data.id == packId
        && data.kind == 'user'
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.version is string && data.version.matches('[0-9]+[.][0-9]+[.][0-9]+')
        && data.assets is list && data.assets.size() <= 500
        && data.createdAt is int && data.modifiedAt is int
        && data.modifiedAt >= data.createdAt;
    }

    match /users/{uid} {
      match /packs/{packId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if registered() && request.auth.uid == uid
          && validUserPack(packId, request.resource.data);
        allow update: if registered() && request.auth.uid == uid
          && validUserPack(packId, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // How much the account stores, kept by the Storage-triggered Cloud
      // Functions (`functions/src/index.ts`) with the admin credential. The
      // owner reads it to warn before an import would go over; nobody writes
      // it from a client, so a user cannot lower their own total.
      match /usage/{document=**} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // The producer's profile (GRV-25): whether they have been through
      // onboarding, and what Cue remembers about them. One document, owner
      // only, never in a project. `src/persistence/profileDocuments.ts` owns
      // the full shape; the rules check what keeps it small and theirs (the
      // note cap is `MAX_MEMORY_NOTES` there).
      match /profile/{document} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && document == 'current'
          && validProfile(request.resource.data);
      }
    }

    function profileFields() {
      return ['schemaVersion', 'onboarding', 'onboardedAt', 'memory', 'notes',
              'laterQuestions', 'validationConsent', 'lastNudgeDay', 'modifiedAt'];
    }

    function memoryFields() {
      return ['taste', 'artists', 'experience', 'goal', 'learn', 'gear'];
    }

    function validProfile(data) {
      return data.keys().hasOnly(profileFields())
        && data.keys().hasAll(profileFields())
        && data.schemaVersion == 1
        && (data.onboarding == null || data.onboarding in ['completed', 'skipped'])
        && (data.onboardedAt == null || data.onboardedAt is int)
        && data.memory is map
        && data.memory.keys().hasOnly(memoryFields())
        && data.memory.keys().hasAll(memoryFields())
        && data.memory.taste is list && data.memory.taste.size() <= 20
        && data.memory.artists is string && data.memory.artists.size() <= 300
        && data.memory.learn is list && data.memory.learn.size() <= 20
        && data.memory.gear is list && data.memory.gear.size() <= 20
        && data.notes is list && data.notes.size() <= 20
        && data.laterQuestions is list && data.laterQuestions.size() <= 5
        && data.validationConsent is bool
        && (data.lastNudgeDay == null || data.lastNudgeDay is string)
        && data.modifiedAt is int && data.modifiedAt >= 0;
    }

    match /projects/{projectId} {
      // A read of a document that does not exist is allowed and returns nothing:
      // every revision-checked write starts by reading the metadata document,
      // which is missing when the project is being created.
      allow read: if resource == null || isMember(resource.data);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && validMetadata(request.resource.data);

      // Ownership cannot be reassigned, and the revision only moves forward.
      allow update: if isMember(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && validMetadata(request.resource.data)
        && request.resource.data.revision >= resource.data.revision;

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /song/{songId} {
        allow read: if memberOfProject(projectId);
        allow create, update: if memberOfProject(projectId)
          && songId == 'current'
          && validChild(projectId, request.resource.data);
        allow delete: if memberOfProject(projectId);
      }

      match /clips/{clipId} {
        allow read: if memberOfProject(projectId);
        allow create, update: if memberOfProject(projectId)
          && request.resource.data.id == clipId
          && validChild(projectId, request.resource.data);
        allow delete: if memberOfProject(projectId);
      }

      match /arrangement/{trackId} {
        allow read: if memberOfProject(projectId);
        allow create, update: if memberOfProject(projectId)
          && request.resource.data.trackId == trackId
          && validChild(projectId, request.resource.data);
        allow delete: if memberOfProject(projectId);
      }
    }

    // Per-user favourite sounds (LIB-011, #691). Favourites belong to the
    // person, so the whole subtree is readable and writable by its owner only.
    // An anonymous identity owns its favourites like a registered one, and an
    // account upgrade keeps the uid, so they follow the person.
    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // One document per sound: a pack-qualified reference and when it was
    // favourited, nothing else (no names, URLs or user-entered text). The
    // document ID is `{packId}~{encoded assetId}`, so it must start with the
    // pack the document names; the decoder checks the rest.
    function validFavourite(favouriteId, data) {
      return data.keys().hasOnly(['schemaVersion', 'packId', 'assetId', 'favouritedAt'])
        && data.keys().hasAll(['schemaVersion', 'packId', 'assetId', 'favouritedAt'])
        && data.schemaVersion == 1
        && data.packId is string && data.packId.matches('^pak_[A-Za-z0-9_-]{21}$')
        && data.assetId is string && data.assetId.size() > 0 && data.assetId.size() <= 200
        && data.favouritedAt is int && data.favouritedAt >= 0
        && favouriteId.matches('^' + data.packId + '~.+$');
    }

    match /users/{userId}/favourites/{favouriteId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
        && validFavourite(favouriteId, request.resource.data);
    }

    // The alpha allowlist (#854). Only an account with the `admin: true`
    // custom claim (granted by `bun run admin:grant`) reaches either
    // collection from a client; everyone else, the person on the list
    // included, can neither read nor write it. The blocking `beforeSignIn`
    // function and the terminal scripts use the admin credential, which rules
    // do not apply to. `src/access/allowlist.ts` owns the shapes, and
    // `allowlist.test.ts` checks these field lists against it.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // One document per normalised (trimmed, lower-cased) address, whose ID is
    // that address.
    function validAllowlistEntry(email, data) {
      return data.keys().hasOnly(['email', 'addedAt'])
        && data.keys().hasAll(['email', 'addedAt'])
        && data.email == email
        && email == email.lower()
        && email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@.]+$')
        && data.addedAt is int && data.addedAt >= 0;
    }

    match /allowlist/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validAllowlistEntry(email, request.resource.data);
    }

    // Refused sign-ins, written by the blocking function only. An admin reads
    // them to approve, and approving deletes the address's attempt.
    match /signInAttempts/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // The assistant's limits (#69, ADR 0006): each account's recent requests,
    // each day's spend, and the kill switch. Only the `assistantTurn` Cloud
    // Function reads or writes them, with the admin credential that rules do
    // not apply to. No client may, the account a usage record belongs to and
    // an admin included, so nobody can lower their own count or flip the
    // switch from a browser; the product owner flips it in the console.
    // `src/assistant/guards.ts` owns the paths and shapes.
    match /assistantUsage/{uid} {
      allow read, write: if false;
    }

    match /assistantSpend/{day} {
      allow read, write: if false;
    }

    match /assistantControl/{document} {
      allow read, write: if false;
    }

    // The assistant's transcripts and each account's answer about keeping
    // them (GRV-8). Only the Cloud Functions read or write either, with the
    // admin credential: `assistantTurn` reads the answer in the same
    // transaction as it writes a transcript, and `assistantRetention` is the
    // one way an account reads or changes its answer. No client may touch
    // them, the owner included, so no browser can cause a transcript to be
    // kept that its account's answer does not allow, or read anyone's.
    // `src/assistant/transcripts.ts` owns the paths and shapes.
    match /assistantTranscripts/{transcriptId} {
      allow read, write: if false;
    }

    match /assistantPreferences/{uid} {
      allow read, write: if false;
    }
  }
}
