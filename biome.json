{
  "$schema": "https://biomejs.dev/schemas/2.2.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!dist",
      "!functions/lib",
      "!public",
      "!docs/design",
      "!playwright-report",
      "!test-results",
      "!vitest-report",
      "!tmp",
      "!scripts/starter-library/acquire/candidate-sources",
      "!scripts/starter-library/acquire/candidates.json",
      "!src/library/factoryLibrary.generated.ts",
      "!src/library/__fixtures__/library.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
